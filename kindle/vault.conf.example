# Optional settings for Vault. Copy to /mnt/us/vault-data/vault.conf on the Kindle.
# Shell syntax, one setting per line, Unix line endings.

# You normally choose the vault in the app. This is only the default for
# "ob setup" when it is run by hand without a vault.
#VAULT_NAME="My notes"

# Time zone for the dates the app shows, if the Kindle's own is wrong or unset.
#TZ_NAME="Europe/Madrid"

# How this Kindle is named in Obsidian's list of devices.
#DEVICE_NAME="Kindle"
