+// isReadOnlyMode (local patch) reports whether the configured sync mode must never
+// modify the remote vault. Upstream v0.3.6 only uses the mode to disable the
+// watcher, so "pull" and "mirror" still uploaded local changes in one-shot sync.
+func (e *Engine) isReadOnlyMode() bool {
+	return e.Config.SyncMode == "pull" || e.Config.SyncMode == "mirror"
+}
+
+// readOnlyPlan (local patch) rewrites a plan so the remote always wins:
+// uploads, remote deletions and merges become downloads when the file exists
+// remotely; local-only files are left untouched.
+func (e *Engine) readOnlyPlan(plan []syncAction, currentRemote map[string]model.FileRecord) []syncAction {
+	out := make([]syncAction, 0, len(plan))
+	for _, a := range plan {
+		switch a.Kind {
+		case syncActionDownload, syncActionDeleteLocal:
+			out = append(out, a)
+		default:
+			if rec, ok := currentRemote[a.Path]; ok && !rec.Deleted {
+				e.Logger.Info().Str("path", a.Path).Str("was", a.Kind.String()).Msg("read-only mode: restoring remote version")
+				out = append(out, syncAction{Path: a.Path, Kind: syncActionDownload})
+			} else {
+				e.Logger.Info().Str("path", a.Path).Str("was", a.Kind.String()).Msg("read-only mode: skipping local-only change")
+			}
+		}
+	}
+	return out
+}
